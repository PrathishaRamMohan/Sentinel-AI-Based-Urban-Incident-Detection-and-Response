        """Latitude > 90 returns 422."""
        payload = {
            "incident_type": "Medical Emergency",
            "latitude": 95.0,
            "longitude": -73.98,
        }
        resp = client.post("/api/v1/citizen-reports", json=payload)
        assert resp.status_code == 422

    def test_invalid_longitude(self, client):
        """Longitude < -180 returns 422."""
        payload = {
            "incident_type": "Medical Emergency",
            "latitude": 40.75,
            "longitude": -200.0,
        }
        resp = client.post("/api/v1/citizen-reports", json=payload)
        assert resp.status_code == 422

    def test_boundary_coordinates(self, client):
        """Coordinates at exact boundaries (90, 180) are accepted."""
        payload = {
            "incident_type": "Other",
            "latitude": 90.0,
            "longitude": 180.0,
        }
        resp = client.post("/api/v1/citizen-reports", json=payload)
        assert resp.status_code == 201


class TestIncidentRetrieval:
    def test_get_incident_by_id(self, client, db_session):
        """GET /api/v1/incidents/{id} returns the incident."""
        incident = Incident(
            type="Fire",
            incident_type="Fire",
            location_name="Test Location",
            latitude=40.75,
            longitude=-73.98,
            severity="High",
            status="Detected",
            source="CITIZEN",
            confidence=0.0,
        )
        db_session.add(incident)
        db_session.flush()

        resp = client.get(f"/api/v1/incidents/{incident.id}")
        assert resp.status_code == 200
        data = resp.json()
        assert data["id"] == str(incident.id)
        assert data["type"] == "Fire"

    def test_get_incident_not_found(self, client):
        """GET /api/v1/incidents/{random_id} returns 404."""
        random_id = uuid.uuid4()
        resp = client.get(f"/api/v1/incidents/{random_id}")
        assert resp.status_code == 404

    def test_list_incidents(self, client, db_session):
        """GET /api/v1/incidents returns a list."""
        incident = Incident(
            type="Road Accident",
            incident_type="Road Accident",
            location_name="Test",
            latitude=40.75,
            longitude=-73.98,
            severity="Medium",
            status="Detected",
            source="CITIZEN",
            confidence=0.0,
        )
        db_session.add(incident)
        db_session.flush()

        resp = client.get("/api/v1/incidents")
        assert resp.status_code == 200
        data = resp.json()
        assert "incidents" in data
        assert "total" in data
        assert data["total"] >= 1


class TestAuth:
    def test_register_new_user(self, client, db_session):
        """POST /api/v1/auth/register creates a user and returns a token."""
        resp = client.post(
            "/api/v1/auth/register",
            json={"email": "newuser@sentinel.test", "password": "securepass123", "full_name": "New User"},
        )
        assert resp.status_code == 201
        data = resp.json()
        assert "access_token" in data
        assert data["user"]["email"] == "newuser@sentinel.test"
        assert data["user"]["role"] == "citizen"

    def test_register_duplicate_email(self, client, test_user):
        """Duplicate email returns 409."""
        resp = client.post(
            "/api/v1/auth/register",
            json={"email": "test_citizen@sentinel.test", "password": "anotherpass"},
        )
        assert resp.status_code == 409

    def test_login_success(self, client, test_user):
        """POST /api/v1/auth/login with valid credentials returns a token."""
        resp = client.post(
            "/api/v1/auth/login",
            json={"email": "test_citizen@sentinel.test", "password": "testpass123"},
        )
        assert resp.status_code == 200
        data = resp.json()
        assert "access_token" in data

    def test_login_wrong_password(self, client, test_user):
        """Wrong password returns 401."""
        resp = client.post(
            "/api/v1/auth/login",
            json={"email": "test_citizen@sentinel.test", "password": "wrongpassword"},
        )
        assert resp.status_code == 401

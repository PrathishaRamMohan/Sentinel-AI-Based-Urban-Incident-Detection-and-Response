"""Backend tests for SENTINEL API.

Tests use httpx.AsyncClient with the FastAPI TestClient, and a test database
session that rolls back after each test to keep tests isolated.

Run with: cd backend && python -m pytest tests/ -v
"""

import os
import sys
import uuid
from typing import Generator

import pytest
from fastapi.testclient import TestClient
from sqlalchemy import create_engine, text
from sqlalchemy.orm import sessionmaker

# Ensure app is importable
sys.path.insert(0, os.path.dirname(os.path.dirname(os.path.abspath(__file__))))

from app.database import Base, get_db
from app.models import User, Incident, CitizenReport
from app.auth import hash_password, create_access_token
from app.main import app

# Use a test database or the Supabase DB with a test schema
TEST_DATABASE_URL = os.getenv("TEST_DATABASE_URL", os.getenv("DATABASE_URL", ""))

if TEST_DATABASE_URL:
    test_engine = create_engine(TEST_DATABASE_URL, pool_pre_ping=True)
    TestSessionLocal = sessionmaker(autocommit=False, autoflush=False, bind=test_engine)
else:
    test_engine = None
    TestSessionLocal = None


@pytest.fixture(scope="function")
def db_session() -> Generator:
    """Provide a database session that rolls back after each test."""
    if test_engine is None:
        pytest.skip("No test database configured")
    # Use a transaction that we roll back
    connection = test_engine.connect()
    transaction = connection.begin()
    session = TestSessionLocal(bind=connection)
    yield session
    session.close()
    transaction.rollback()
    connection.close()


@pytest.fixture(scope="function")
def client(db_session) -> Generator:
    """FastAPI TestClient with the test database session injected."""
    def override_get_db():
        yield db_session

    app.dependency_overrides[get_db] = override_get_db
    yield TestClient(app)
    app.dependency_overrides.clear()



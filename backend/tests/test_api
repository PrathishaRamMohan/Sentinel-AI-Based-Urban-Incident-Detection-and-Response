class TestCitizenReportCreation:
    def test_create_citizen_report_anonymous(self, client, db_session):
        """POST /api/v1/citizen-reports creates a report and incident without auth."""
        payload = {
            "incident_type": "Road Accident",
            "description": "Two-car collision at intersection",
            "latitude": 40.7589,
            "longitude": -73.9851,
        }
        resp = client.post("/api/v1/citizen-reports", json=payload)
        assert resp.status_code == 201
        data = resp.json()
        assert data["incident_type"] == "Road Accident"
        assert data["latitude"] == 40.7589
        assert data["longitude"] == -73.9851
        assert data["incident_id"] is not None

        # Verify incident was created
        incident_id = uuid.UUID(data["incident_id"])
        incident = db_session.query(Incident).filter(Incident.id == incident_id).first()
        assert incident is not None
        assert incident.source == "CITIZEN"
        assert incident.status == "Detected"
        assert incident.type == "Road Accident"

    def test_create_citizen_report_authenticated(self, client, auth_headers):
        """POST /api/v1/citizen-reports with auth links the report to the user."""
        payload = {
            "incident_type": "Fire",
            "description": "Small fire in trash bin",
            "latitude": 40.7505,
            "longitude": -73.9934,
        }
        resp = client.post("/api/v1/citizen-reports", json=payload, headers=auth_headers)
        assert resp.status_code == 201
        data = resp.json()
        assert data["user_id"] is not None

    def test_create_report_invalid_incident_type(self, client):
        """Invalid incident type returns 422."""
        payload = {
            "incident_type": "Alien Invasion",
            "latitude": 40.75,
            "longitude": -73.98,
        }
        resp = client.post("/api/v1/citizen-reports", json=payload)
        assert resp.status_code == 422

    def test_create_report_missing_location(self, client):
        """Missing latitude/longitude returns 422."""
        payload = {
            "incident_type": "Fire",
            "description": "No location provided",
        }
        resp = client.post("/api/v1/citizen-reports", json=payload)
        assert resp.status_code == 422


class TestCoordinateValidation:
